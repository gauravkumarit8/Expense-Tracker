# Copy this file to keystore.properties (same directory) and fill in real
# values — keystore.properties itself is git-ignored and must NEVER be
# committed. See REQUIREMENTS.md ยง10.4 for how to generate the keystore
# this points to, and why an "upload key" (this one) is intentionally
# separate from Google's own "app signing key" if you enroll in Play App
# Signing (recommended — see ยง10.4).

storeFile=../release-upload-key.jks
storePassword=CHANGE_ME
keyAlias=expense-tracker-upload
keyPassword=CHANGE_ME
