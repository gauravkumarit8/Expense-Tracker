<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS permissions (RECEIVE_SMS/READ_SMS) are permanently NOT used.
         Google's SMS and Call Log Permissions policy restricts these to
         apps that are the user's default SMS/Phone/Assistant handler — an
         expense tracker does not qualify, and Play Console review flags
         even inert/commented manifest declarations of these permissions.
         NotificationListenerService below is the sole, sufficient capture
         path (verified against 7+ real bank/UPI message formats — see
         REQUIREMENTS.md ยง3 and ยง6). Do not re-add these permissions or a
         SmsReceiver for a Play Store-distributed build. -->

    <!-- Needed so the listener service survives OEM aggressive battery killers -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Required on Android 13+ to show bill/subscription reminder and unusual-spend notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- INTERNET permission — added 2026-08-20, the first exception to this
         app's previously-total on-device-only design. Scoped to three uses,
         all talking to Google's own servers, never a backend of ours:
         (1) Play Billing Library, for subscription purchase/status checks;
         (2) Play Core In-App Update API, for update-availability checks;
         (3) Google Mobile Ads (AdMob), for banner ads shown to free-tier
         users only (hidden for Pro subscribers). No custom server exists
         for this app and none is planned — all financial transaction data
         still never leaves the device either way. See REQUIREMENTS.md
         ยง2.17 and ยง2.18 for the full architecture decisions and Data
         Safety form implications this has. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExpenseTrackerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="31">

        <!-- AdMob App ID — this is GOOGLE'S OFFICIAL TEST APP ID
             (ca-app-pub-3940256099942544~3347511713), safe to ship in
             debug builds and guaranteed to only ever serve test ads.
             MUST be replaced with a real App ID from your own AdMob
             account (Apps > [your app] > App settings) before any
             release build — shipping the test ID in a release build
             means zero ad revenue, not a crash, but it must be fixed.
             See REQUIREMENTS.md ยง2.18. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sole transaction-capture path: reads notification text from
             banking/UPI/SMS apps. Requires user to grant special
             "Notification access" in Settings — see REQUIREMENTS.md ยง3.5
             for the Play Console Permissions Declaration Form requirement
             this triggers. -->
        <service
            android:name=".listener.NotificationCaptureService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>