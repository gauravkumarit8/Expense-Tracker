<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS permissions (RECEIVE_SMS/READ_SMS) are permanently NOT used.
         Google's SMS and Call Log Permissions policy restricts these to
         apps that are the user's default SMS/Phone/Assistant handler — an
         expense tracker does not qualify, and Play Console review flags
         even inert/commented manifest declarations of these permissions.
         NotificationListenerService below is the sole, sufficient capture
         path (verified against 7+ real bank/UPI message formats — see
         REQUIREMENTS.md ยง3 and ยง6). Do not re-add these permissions or a
         SmsReceiver for a Play Store-distributed build. -->

    <!-- Needed so the listener service survives OEM aggressive battery killers -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Required on Android 13+ to show bill/subscription reminder and unusual-spend notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No INTERNET permission requested on purpose: this app is on-device only.
         Do not add android.permission.INTERNET unless a feature genuinely requires
         network access — its absence is itself a strong privacy/security signal
         for Play Store review and for users. -->

    <application
        android:name=".ExpenseTrackerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sole transaction-capture path: reads notification text from
             banking/UPI/SMS apps. Requires user to grant special
             "Notification access" in Settings — see REQUIREMENTS.md ยง3.5
             for the Play Console Permissions Declaration Form requirement
             this triggers. -->
        <service
            android:name=".listener.NotificationCaptureService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>