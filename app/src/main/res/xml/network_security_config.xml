<?xml version="1.0" encoding="utf-8"?>
<!--
  cleartextTrafficPermitted is false: all network traffic must use HTTPS.
  The app's only network access is via Google's own SDKs (AdMob, Play
  Billing), both of which already use HTTPS exclusively — this config adds
  a hard guarantee against any accidental/future cleartext request rather
  than trusting that to hold by convention. If a future feature needs
  network access beyond Google's SDKs, add explicit domain allowlisting
  here rather than relaxing this base config, and update
  REQUIREMENTS.md accordingly.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>