      "debitedRegex": "(?i)(?:sent|paid|debited)?\\s*(?:rs\\.?|inr)\\s?([0-9,]+(?:\\.[0-9]{1,2})?)\\s?(?:sent|paid|debited)?.{0,40}?to\\s+(?:mr\\.?|mrs\\.?|ms\\.?)?\\s*([A-Za-z ]{2,30}?)(?=\\s+on\\b|\\.|$)",
      "creditedRegex": "(?i)(?:received|credited)?\\s*(?:rs\\.?|inr)\\s?([0-9,]+(?:\\.[0-9]{1,2})?)\\s?(?:received|credited)?.{0,40}?from\\s+(?:mr\\.?|mrs\\.?|ms\\.?)?\\s*([A-Za-z ]{2,30}?)(?=\\s+on\\b|\\.|$)"
    },
    {
      "senderMatch": "GENERIC_UPI",
      "debitedRegex": "(?i)(?:sent|paid|debited)?\\s*(?:rs\\.?|inr)\\s?([0-9,]+(?:\\.[0-9]{1,2})?)\\s?(?:sent|paid|debited)?.{0,40}?to\\s+(?:mr\\.?|mrs\\.?|ms\\.?)?\\s*([A-Za-z0-9@._\\- ]{2,30}?)(?=\\s+on\\b|\\.|$)",
      "creditedRegex": "(?i)(?:received|credited)?\\s*(?:rs\\.?|inr)\\s?([0-9,]+(?:\\.[0-9]{1,2})?)\\s?(?:received|credited)?.{0,40}?from\\s+(?:mr\\.?|mrs\\.?|ms\\.?)?\\s*([A-Za-z0-9@._\\- ]{2,30}?)(?=\\s+on\\b|\\.|$)"
